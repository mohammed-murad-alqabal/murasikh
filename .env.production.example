# Copy to .env.production and keep the real file outside Git.
# Generate a strong key with: openssl rand -hex 64

POSTGRES_USER=murassikh
POSTGRES_DB=murassikh_db
POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-at-least-64-random-bytes
CORS_ORIGINS=https://app.example.com
GEMINI_API_KEY=
OPENAI_API_KEY=

# Public listener ports. PostgreSQL and Redis are intentionally not published.
HTTP_PORT=80
HTTPS_PORT=443

# Required certificate files, mounted by docker-compose.production.yml:
# deploy/certs/fullchain.pem
# deploy/certs/privkey.pem
